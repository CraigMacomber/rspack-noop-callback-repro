{
  "name": "rspack-noop-callback-repro",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs rspack && node scripts/build.mjs webpack",
    "build:rspack": "node scripts/build.mjs rspack",
    "build:webpack": "node scripts/build.mjs webpack",
    "build:canary": "node scripts/build.mjs canary",
    "verify": "node scripts/verify.mjs rspack webpack",
    "verify:canary": "node scripts/verify.mjs canary webpack",
    "repro": "pnpm build && pnpm verify",
    "repro:canary": "pnpm build:canary && pnpm build:webpack && pnpm verify:canary"
  },
  "dependencies": {
    "@fluidframework/core-utils": "3.7.0",
    "@fluidframework/tree": "3.7.0"
  },
  "devDependencies": {
    "@rspack/core": "2.3.1",
    "@rspack-canary/core": "2.3.2-canary-17f2cbb4-20261104201527",
    "webpack": "5.112.2"
  },
  "packageManager": "pnpm@11.27.0"
}
